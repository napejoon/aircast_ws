__pycache__/
*.pyc
.venv/
node_modules/
.env
build/
devel/
install/
log/

# Flutter / Dart
.dart_tool/
.packages
*.iml
sender/android/.gradle/
sender/ios/Pods/

# The scaffold tools/scaffold-sender.sh regenerates. Committing any of it means
# `flutter create` stops refreshing it, and the script's pin guards then pass
# against a file that no longer tracks the template. local.properties also
# carries a machine-specific absolute SDK path.
sender/android/local.properties
sender/android/gradle.properties
sender/android/gradlew
sender/android/gradlew.bat
sender/android/gradle/
sender/android/*.gradle.kts
sender/android/app/*.gradle.kts
sender/android/app/src/main/res/
# ...except the launcher icon, which is ours and not the scaffold's. Git cannot
# re-include a file whose parent directory is excluded, so the directory is
# un-excluded and its contents excluded instead. `flutter create` never
# overwrites a file that is already there (tools/scaffold-sender.sh), so
# committing these five is the whole of what keeps the APK from shipping the
# default Flutter logo -- which is what every APK built so far has carried,
# because branding/make-icons.py wrote them into an ignored directory and CI
# starts from a clean checkout.
!sender/android/app/src/main/res/
sender/android/app/src/main/res/*
!sender/android/app/src/main/res/mipmap-*/
!sender/android/app/src/main/res/mipmap-*/ic_launcher.png
sender/android/app/src/profile/
sender/ios/Runner/
sender/ios/Runner.xcodeproj/
sender/ios/Runner.xcworkspace/
sender/ios/Flutter/

# CMake
receiver/build/

# Python
.pytest_cache/
