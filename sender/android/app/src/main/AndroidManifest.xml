<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- libwebrtc's NetworkMonitor asks ConnectivityService for the active
         network as PeerConnection comes up. Without this the call throws
         SecurityException into JNI, where jvm.cc line 81 turns an unexpected
         Java exception into RTC_CHECK(false) — the process aborts on
         network_thread with no Dart error and no crash dialog, four seconds
         after pairing. flutter_webrtc declares nothing in its own manifest, so
         the permission has to be here. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Declared here and requested in UsbCastPlugin ("askToNotify"), called
         from main.dart when the app opens. Declaring it alone bought nothing:
         since Android 13 a notification from an app that has not been granted
         this is dropped at enqueue, which is how the cast notification came to
         be posted sixteen times and displayed none. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The cast service holds a screen wake lock: Android stops a projection
         when the screen locks, and the app's own window is not in front while
         the user mirrors some other app. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The pairing QR. mobile_scanner declares this too and the merge would
         supply it either way; it is written here so that reading this file
         answers what the app asks for, rather than answering it after a
         build. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Fully qualified on purpose: the Gradle namespace `flutter create`
         generates is derived from the project name, so a relative ".MainActivity"
         would resolve to a class that does not exist. -->
    <application
        android:label="Quoise"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name="io.aircast.sender.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 14+ refuses getMediaProjection() unless this service is
             already in the foreground with this exact type. -->
        <service
            android:name="io.aircast.sender.UsbCastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
